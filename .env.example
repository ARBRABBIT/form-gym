# Register an app at https://developer.whoop.com/ and keep secrets server-side.
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
# Must exactly match your WHOOP app redirect and use the same HTTPS origin as Form.
WHOOP_REDIRECT_URI=https://your-app.example/api/whoop/callback
# Generate 32 random bytes as 64 hex characters; do not use NEXT_PUBLIC_ variables.
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
WHOOP_COOKIE_KEY=

# Optional cloud fallback only. Default scale reading runs locally in the browser.
GOOGLE_VISION_API_KEY=
# Persistent server directory for accounts, journals, wearable credentials, push preferences and VAPID keys (Node 24+).
# Required on a persistent volume in production; defaults to .form-data in development.
# FORM_DATA_DIR=/absolute/path/to/form-data
# Set a real contact URI when deploying push delivery.
VAPID_SUBJECT=https://your-app.example
# Only needed if an external scheduler calls POST /api/reminders/run every minute.
REMINDER_CRON_SECRET=

# Browser-only accounts and journal storage (default). No hosted database needed.
NEXT_PUBLIC_ACCOUNT_MODE=local
# Set to server only on a persistent Node host with FORM_DATA_DIR configured.
